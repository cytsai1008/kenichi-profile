# ============================================================
# Gallery Explicit Sync — required for `npm run build` / `gallery:sync`
# Copy to .env.builder.dev or .env.builder.prod and fill in real values before building.
# ============================================================

# Cloudflare Access Service Token (protects the private sync host)
GALLERY_CF_CLIENT_ID=
GALLERY_CF_CLIENT_SECRET=

# Ed25519 signing key — base64-encoded 32-byte seed
# Generate: openssl rand -base64 32
GALLERY_SIGNING_KEY=

# ============================================================
# Optional overrides
# ============================================================

# Override the private sync host (default: https://sync.kenichi-explicit.photocat.blue)
# For local dev against the Go server: http://localhost:8081
# GALLERY_SYNC_HOST=http://localhost:8081

# Skip CF-Access credential check and Ed25519 signing (local dev only — matches GALLERY_DEV_SKIP_AUTH on the server)
# GALLERY_DEV_SKIP_AUTH=true

# Override the public asset host for viewer/thumb URLs baked into the build manifest
# (default: https://kenichi.photocat.blue/alt-media — routed via the Cloudflare proxy worker)
# For local dev: set to wherever the Go server serves /_viewer/ and /_thumbs/
# GALLERY_PUBLIC_HOST=http://localhost:8080

# Override the logical namespace prefix (default: gallery-explicit)
# GALLERY_NAMESPACE=gallery-explicit

# ============================================================
# Proxy Worker local dev — used with `wrangler dev` in proxy-worker/
# For local dev against the Go server: http://localhost:8080
# Set via CLI: wrangler dev --var UPSTREAM_OVERRIDE:http://localhost:8080
# ============================================================
# UPSTREAM_OVERRIDE=http://localhost:8080
