---
import BaseHead from "../components/BaseHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CookieConsent from "../components/CookieConsent.astro";
import NavBar from "../components/NavBar.vue";
import type { ImageMetadata } from "astro";
import {
  getLocaleFromUrl,
  locales,
  localeLang,
  localePath,
  switchLocalePath,
  t,
  type Locale,
} from "../i18n/utils";
import { SITE_TITLE } from "../consts";

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  locale?: Locale;
  type?: "website" | "article";
  pubDate?: Date;
  updatedDate?: Date;
}

const locale: Locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const tr = t(locale);
const lang = localeLang[locale];

const {
  title = SITE_TITLE,
  description = tr.home.tagline,
  image,
  type,
  pubDate,
  updatedDate,
} = Astro.props;

const navLinks = [
  { href: localePath("/", locale), label: tr.nav.home },
  { href: localePath("/blog", locale), label: tr.nav.blog },
  { href: localePath("/gallery", locale), label: tr.nav.gallery },
  { href: localePath("/photos", locale), label: tr.nav.photos },
  { href: localePath("/about", locale), label: tr.nav.about },
];

// Plain <a> equivalents of the two NavBar controls that are pure JS: the
// hamburger (mobile has no other route to the page links) and the language
// listbox (its <button>s call switchLang()). Locale links are also the only
// way to reach a translation without the client-side redirect script.
const fallbackLocales = locales.map((loc) => ({
  href: switchLocalePath(Astro.url, loc),
  label: tr.lang[loc],
  lang: localeLang[loc],
  current: loc === locale,
}));
---

<!doctype html>
<html lang={lang} class="">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      locale={locale}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
    />
    <slot name="chiron-font" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{tr.a11y.skipToContent}</a>

    <NavBar
      client:load
      links={navLinks}
      locale={locale}
      currentPath={Astro.url.pathname}
      themeDarkLabel={tr.theme.dark}
      themeLightLabel={tr.theme.light}
      langLabel={tr.lang.label}
    />

    {
      /* Hidden via `html.js` in global.css, not <noscript>: this must also cover the
        case where JS is enabled but the NavBar bundle never loads or is blocked. */
    }
    <nav class="nojs-nav border-b border-border px-4 py-3" aria-label={tr.a11y.mainNavigation}>
      <ul class="m-0 mx-auto flex max-w-5xl list-none flex-wrap gap-x-4 gap-y-1 p-0 md:hidden">
        {
          navLinks.map((link) => (
            <li>
              <a class="text-sm font-medium" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul
        class="m-0 mx-auto mt-1 flex max-w-5xl list-none flex-wrap gap-x-4 gap-y-1 p-0 text-fg-muted"
      >
        {
          fallbackLocales.map((loc) => (
            <li>
              <a
                class="text-xs"
                href={loc.href}
                hreflang={loc.lang}
                aria-current={loc.current ? "true" : undefined}
              >
                {loc.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <SiteFooter locale={locale} />
    <CookieConsent />
  </body>
</html>

<script>
  import { initScrollAnimations } from "../scripts/scrollAnimations";
  initScrollAnimations();
</script>
