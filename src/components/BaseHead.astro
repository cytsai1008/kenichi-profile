---
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { Seo } from "astro-seo-meta";
import { Schema } from "astro-seo-schema";
import { locales, localeLang, localePath, type Locale } from "../i18n/utils";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  locale?: Locale;
  type?: "website" | "article";
  pubDate?: Date;
  updatedDate?: Date;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {
  title,
  description,
  image,
  locale = "en",
  type = "website",
  pubDate,
  updatedDate,
} = Astro.props;

// Derive OG image path from current URL: strip leading slash, map to /og/[path].png
const stripped = Astro.url.pathname.replace(/^\/|\/$/g, ""); // "" | "zh-tw" | "zh-tw/blog/post"
const isHome = stripped === "" || stripped === "zh-tw" || stripped === "zh-cn";
const pagePath = isHome ? (stripped ? `${stripped}_home` : "home") : stripped.replace(/\//g, "_");
const socialImage = image
  ? new URL(image.src, Astro.url.origin)
  : new URL(`/og/${pagePath}.png`, Astro.site);
const fullTitle = `${SITE_TITLE} | ${title}`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f3f8fb" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17181c" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="generator" content={Astro.generator} />

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Noto+Sans:wght@400;500;700&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Sans+TC:wght@400;500;700&display=swap"
  rel="stylesheet"
/>

<!-- Canonical & hreflang -->
<link rel="canonical" href={canonicalURL} />
{
  locales.map((loc) => {
    const path = localePath(Astro.url.pathname.replace(/^\/(zh-tw|zh-cn)/, ""), loc);
    return <link rel="alternate" hreflang={localeLang[loc]} href={new URL(path, Astro.site)} />;
  })
}
<link
  rel="alternate"
  hreflang="x-default"
  href={new URL(Astro.url.pathname.replace(/^\/(zh-tw|zh-cn)/, "") || "/", Astro.site)}
/>

<!-- Primary Meta, Open Graph, Twitter -->
<Seo
  title={fullTitle}
  description={description}
  facebook={{
    url: canonicalURL.href,
    type: type === "article" ? "article" : "website",
    image: socialImage.href,
  }}
  twitter={{ card: "summary_large_image", image: socialImage.href }}
/>

<!-- Google Analytics -->
<!-- Google tag (gtag.js) -->
<script
  is:inline
  async
  type="text/plain"
  data-category="analytics"
  src="https://www.googletagmanager.com/gtag/js?id=G-GRXHJS3F61"></script>
<script is:inline type="text/plain" data-category="analytics">
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());

  gtag("config", "G-GRXHJS3F61");
</script>

<!-- Microsoft Clarity -->
<script is:inline type="text/plain" data-category="analytics">
  (function (c, l, a, r, i, t, y) {
    c[a] =
      c[a] ||
      function () {
        (c[a].q = c[a].q || []).push(arguments);
      };
    t = l.createElement(r);
    t.async = 1;
    t.src = "https://www.clarity.ms/tag/" + i;
    y = l.getElementsByTagName(r)[0];
    y.parentNode.insertBefore(t, y);
  })(window, document, "clarity", "script", "w7t8i6b9gr");
</script>

<!-- Cloudflare Web Analytics -->
<script
  is:inline
  defer
  type="text/plain"
  data-category="analytics"
  src="https://static.cloudflareinsights.com/beacon.min.js"
  data-cf-beacon='{"token": "fe14d12af89f461a86f3214e0dd2de9b"}'
></script><!-- End Cloudflare Web Analytics -->

<!-- Open Graph extras (not covered by astro-seo-meta) -->
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:locale" content={localeLang[locale]} />
{
  type === "article" && pubDate && (
    <meta property="article:published_time" content={pubDate.toISOString()} />
  )
}
{
  type === "article" && updatedDate && (
    <meta property="article:modified_time" content={updatedDate.toISOString()} />
  )
}
{type === "article" && <meta property="article:author" content={SITE_TITLE} />}

<!-- JSON-LD -->
<Schema
  item={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": `${Astro.site}#website`,
        name: SITE_TITLE,
        url: Astro.site?.href ?? "/",
        description: SITE_DESCRIPTION,
        inLanguage: localeLang[locale],
        author: { "@id": new URL("/about", Astro.site).href },
      },
      {
        "@type": "Person",
        "@id": new URL("/about", Astro.site).href,
        name: SITE_TITLE,
        url: Astro.site?.href ?? "/",
        sameAs: [
          "https://r.photocat.blue/facebook",
          "https://r.photocat.blue/x",
          "https://r.photocat.blue/github",
        ],
      },
    ],
  }}
/>

<!-- Apply theme before paint to avoid flash -->
<script is:inline>
  (function () {
    const pathname = window.location.pathname;
    const isPrefixedRoute = /^\/(zh-tw|zh-cn)(\/|$)/.test(pathname);

    if (!isPrefixedRoute) {
      const cookieMatch = document.cookie.match(/(?:^|;\s*)preferred-locale=([^;]+)/);
      let locale = cookieMatch ? decodeURIComponent(cookieMatch[1]) : "";

      if (!locale) {
        const preferredLanguages =
          Array.isArray(navigator.languages) && navigator.languages.length
            ? navigator.languages
            : [navigator.language];

        for (const language of preferredLanguages) {
          const normalized = language.toLowerCase();
          if (
            normalized === "zh-tw" ||
            normalized.startsWith("zh-tw") ||
            normalized.includes("hant")
          ) {
            locale = "zh-tw";
            break;
          }
          if (
            normalized === "zh-cn" ||
            normalized.startsWith("zh-cn") ||
            normalized.startsWith("zh") ||
            normalized.includes("hans")
          ) {
            locale = "zh-cn";
            break;
          }
          if (normalized.startsWith("en")) {
            locale = "en";
            break;
          }
        }
      }

      if (locale === "zh-tw" || locale === "zh-cn") {
        const target = `/${locale}${pathname}${window.location.search}${window.location.hash}`;
        window.location.replace(target);
        return;
      }
    }

    const stored = localStorage.getItem("theme"); // 'light' | 'dark' | 'system' | null
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    const isDark = stored === "dark" || (stored !== "light" && prefersDark);
    document.documentElement.classList.toggle("dark", isDark);
    document.documentElement.classList.add("js"); // hide [data-animate] before first paint
  })();
</script>
