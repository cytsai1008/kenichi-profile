---
import { type Locale, localePath } from "../i18n/utils";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-12 border-t border-border px-4 py-6 text-center">
  <div class="mt-3 flex flex-wrap items-baseline justify-center gap-x-6 gap-y-1">
    <span class="text-xs" style="opacity: 0.5">
      <a
        href={localePath("/blog", locale)}
        class="text-fg-muted transition-opacity hover:opacity-100">Blog</a
      >
      <span class="mx-1.5" style="opacity: 0.4">·</span>
      <a
        href="https://creativecommons.org/licenses/by/4.0/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-fg-muted transition-opacity hover:opacity-100">CC BY 4.0</a
      >
    </span>
    <span class="text-xs" style="opacity: 0.5">
      <a
        href={localePath("/photos", locale)}
        class="text-fg-muted transition-opacity hover:opacity-100">Photos</a
      >
      <span class="mx-1.5" style="opacity: 0.4">·</span>
      <a
        href="https://creativecommons.org/licenses/by/4.0/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-fg-muted transition-opacity hover:opacity-100">CC BY 4.0</a
      >
    </span>
    <span class="text-xs" style="opacity: 0.5">
      <a
        href={localePath("/gallery", locale)}
        class="text-fg-muted transition-opacity hover:opacity-100">Gallery</a
      >
      <span class="mx-1.5" style="opacity: 0.4">·</span>
      <span class="text-fg-muted">All Rights Reserved</span>
    </span>
    <span class="text-xs" style="opacity: 0.5">
      <span class="text-fg-muted">Source</span>
      <span class="mx-1.5" style="opacity: 0.4">·</span>
      <a
        href="https://opensource.org/licenses/MIT"
        target="_blank"
        rel="noopener noreferrer"
        class="text-fg-muted transition-opacity hover:opacity-100">MIT</a
      >
    </span>
  </div>
  <p class="m-0 mt-3 text-xs font-medium tracking-widest text-fg-muted" style="opacity: 0.5">
    &copy; {year} 健一 Kenichi
  </p>
</footer>
