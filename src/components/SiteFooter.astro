---
import { type Locale, localePath } from "../i18n/utils";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-12 border-t border-border px-4 py-6 text-center">
  <div class="mt-3 flex flex-wrap items-baseline justify-center gap-x-6 gap-y-1">
    <span class="text-xs" style="opacity: 0.5">
      <a
        href={localePath("/blog", locale)}
        class="text-fg-muted transition-opacity hover:opacity-100">Articles</a
      >
      <span class="mx-1.5" style="opacity: 0.4">·</span>
      <a
        href="https://creativecommons.org/licenses/by/4.0/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-fg-muted transition-opacity hover:opacity-100">CC BY 4.0</a
      >
    </span>
    <span aria-hidden="true" class="text-fg-muted" style="opacity: 0.35">|</span>
    <span class="text-xs" style="opacity: 0.5">
      <a
        href={localePath("/photos", locale)}
        class="text-fg-muted transition-opacity hover:opacity-100">Photos</a
      >
      <span class="mx-1.5" style="opacity: 0.4">·</span>
      <a
        href="https://creativecommons.org/licenses/by/4.0/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-fg-muted transition-opacity hover:opacity-100">CC BY 4.0</a
      >
    </span>
    <span aria-hidden="true" class="text-fg-muted" style="opacity: 0.35">|</span>
    <span class="text-xs" style="opacity: 0.5">
      <a
        href={localePath("/gallery", locale)}
        class="text-fg-muted transition-opacity hover:opacity-100">Commissions</a
      >
      <span class="mx-1.5" style="opacity: 0.4">·</span>
      <a
          href="https://en.wikipedia.org/wiki/All_rights_reserved"
          target="_blank"
          rel="noopener noreferrer"
          class="text-fg-muted">All Rights Reserved</a>
    </span>
    <span aria-hidden="true" class="text-fg-muted" style="opacity: 0.35">|</span>
    <span class="text-xs" style="opacity: 0.5">
      <a
          href="https://github.com/cytsai1008/kenichi-profile"
          target="_blank"
          rel="noopener noreferrer"
          class="text-fg-muted">Source</a>
      <span class="mx-1.5" style="opacity: 0.4">·</span>
      <a
        href="https://choosealicense.com/licenses/mit/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-fg-muted transition-opacity hover:opacity-100">MIT</a
      >
    </span>
  </div>
  <p class="m-0 mt-3 text-xs font-medium tracking-widest text-fg-muted" style="opacity: 0.5">
    &copy; {year} <a
      href="https://link.photocat.blue"
      target="_blank"
      rel="noopener noreferrer"
  >健一 Kenichi</a>
  </p>
</footer>
