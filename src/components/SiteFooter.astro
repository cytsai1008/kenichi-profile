---
import { type Locale, localePath } from "../i18n/utils";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-12 border-t border-border px-4 py-6 text-center">
  <div
    data-animate-stagger
    class="mt-3 flex flex-col items-center gap-y-1 sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-6"
  >
    <span data-animate class="text-xs" style="opacity: 0.5">
      <a href={localePath("/blog", locale)}>Articles</a>
      <span class="mx-1.5" style="opacity: 0.4">&</span>
      <a href={localePath("/photos", locale)}>Photos</a>
      <span class="mx-1.5" style="opacity: 0.4">·</span>
      <a
        href="https://creativecommons.org/licenses/by/4.0/"
        target="_blank"
        rel="noopener noreferrer">CC BY 4.0</a
      >
    </span>
    <span
      data-animate
      aria-hidden="true"
      class="hidden text-fg-muted sm:inline"
      style="opacity: 0.35">|</span
    >
    <span data-animate class="text-xs" style="opacity: 0.5">
      <a href={localePath("/gallery", locale)}>Art Collections</a>
      <span class="mx-1.5" style="opacity: 0.4">·</span>
      <a
        href="https://en.wikipedia.org/wiki/All_rights_reserved"
        target="_blank"
        rel="noopener noreferrer">All Rights Reserved</a
      >
    </span>
    <span
      data-animate
      aria-hidden="true"
      class="hidden text-fg-muted sm:inline"
      style="opacity: 0.35">|</span
    >
    <span data-animate class="text-xs" style="opacity: 0.5">
      <a
        href="https://github.com/cytsai1008/kenichi-profile"
        target="_blank"
        rel="noopener noreferrer">Source Code</a
      >
      <span class="mx-1.5" style="opacity: 0.4">·</span>
      <a href="https://choosealicense.com/licenses/mit/" target="_blank" rel="noopener noreferrer"
        >MIT</a
      >
    </span>
  </div>
  <p
    data-animate
    class="m-0 mt-3 text-xs font-medium tracking-widest text-fg-muted"
    style="opacity: 0.5"
  >
    &copy; {year}
    <a href="https://link.photocat.blue" target="_blank" rel="noopener noreferrer">健一 Kenichi</a>
  </p>
</footer>
