---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { Pin } from "@lucide/astro";
import FormattedDate from "./FormattedDate.astro";
import { localePath, t, type Locale } from "../i18n/utils";
import { getBlogSlug } from "../lib/blog";

interface Props {
  post: CollectionEntry<"blog">;
  locale?: Locale;
  featured?: boolean;
}

const { post, locale = "en", featured = false } = Astro.props;
const tr = t(locale);
const postHref = localePath(`/blog/${getBlogSlug(post.id)}/`, locale);
const blogFontClass =
  locale === "zh-tw" ? "font-noto-tc" : locale === "zh-cn" ? "font-noto-sc" : "";

const ogPath = `/og/${postHref.replace(/^\/|\/$/g, "").replace(/\//g, "_")}.png`;
---

<article
  data-animate
  class:list={[
    "group flex flex-col overflow-hidden rounded-2xl border border-border bg-surface-alt transition-shadow hover:shadow-lg",
    blogFontClass,
  ]}
>
  {
    post.data.heroImage ? (
      <a href={postHref} class="block h-36 overflow-hidden" tabindex="-1" aria-hidden="true">
        <Image
          src={post.data.heroImage}
          alt=""
          width={720}
          height={240}
          class="h-36 w-full object-cover transition-transform duration-150 group-hover:scale-105"
        />
      </a>
    ) : (
      <a href={postHref} class="block h-36 overflow-hidden" tabindex="-1" aria-hidden="true">
        <img
          src={ogPath}
          alt=""
          width={720}
          height={240}
          class="h-36 w-full object-cover object-[50%_-10px] transition-transform duration-150 group-hover:scale-105"
        />
      </a>
    )
  }

  <div class="flex flex-1 flex-col p-5">
    <p class="mb-1 text-xs text-fg-muted">
      <FormattedDate date={post.data.pubDate} />
    </p>
    <h3 class:list={["leading-snug font-bold text-fg", featured ? "text-xl" : "text-base"]}>
      <a href={postHref} class="inline-flex items-baseline gap-2 no-underline hover:underline">
        {
          featured && (
            <Pin
              class="size-4 shrink-0 translate-y-[1.5px] text-highlight-dim"
              aria-hidden="true"
            />
          )
        }
        <span>{post.data.title}</span>
      </a>
    </h3>
    {
      post.data.description && (
        <p class="mt-2 line-clamp-3 flex-1 text-sm text-fg-muted">{post.data.description}</p>
      )
    }
    <a href={postHref} class="mt-3 text-sm font-medium text-accent no-underline">
      {tr.blog.readMore} →
    </a>
  </div>
</article>
