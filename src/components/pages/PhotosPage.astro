---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { Schema } from "astro-seo-schema";
import Layout from "../../layouts/Layout.astro";
import PhotoViewer from "../PhotoViewer.vue";
import { t, type Locale } from "../../i18n/utils";
import type { PhotoItem } from "../PhotoViewer.vue";
import { SITE_TITLE } from "../../consts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

function formatAlbumName(album: string) {
  return album.replace(/[-_]+/g, " ").replace(/\b\w/g, (char) => char.toUpperCase());
}

const entries = (await getCollection("photos")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/photos/**/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP,avif,AVIF,tiff,TIFF,tif,TIF,heic,HEIC,heif,HEIF}",
  { eager: true }
);

const photoOriginalUrls = import.meta.glob<string>(
  "/src/content/photos/**/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP,avif,AVIF,tiff,TIFF,tif,TIF,heic,HEIC,heif,HEIF}",
  {
    query: "?url",
    import: "default",
    eager: true,
  }
);

async function toPhotoItem(entry: (typeof entries)[number]): Promise<PhotoItem> {
  const imageModule = photoModules[entry.data.imagePath]?.default;
  const optimizedViewer = imageModule
    ? await getImage({
        src: imageModule,
        width: Math.min(imageModule.width, 2200),
        quality: 90,
      })
    : null;
  const optimizedThumb = imageModule
    ? await getImage({
        src: imageModule,
        width: 640,
        height: 640,
        fit: "cover",
        quality: 85,
      })
    : null;
  const originalUrl = photoOriginalUrls[entry.data.imagePath];

  return {
    src: optimizedViewer?.src ?? originalUrl ?? entry.data.imagePath,
    downloadSrc: originalUrl ?? entry.data.imagePath,
    thumb: optimizedThumb?.src ?? entry.data.imagePath,
    width: optimizedViewer?.attributes.width ?? entry.data.exif.width ?? imageModule?.width ?? 0,
    height:
      optimizedViewer?.attributes.height ?? entry.data.exif.height ?? imageModule?.height ?? 0,
    slug: entry.data.album ? `${entry.data.album}_${entry.data.slug}` : entry.data.slug,
    alt: entry.data.title,
    title: entry.data.title,
    exif: {
      camera: entry.data.exif.camera,
      lens: entry.data.exif.lens,
      focalLength: entry.data.exif.focalLength,
      aperture: entry.data.exif.aperture,
      shutter: entry.data.exif.shutter,
      iso: entry.data.exif.iso,
      date: entry.data.exif.date,
    },
    exifLabels: tr.photos.exif,
  };
}

const aboutUrl = new URL("/about", Astro.site).href;
const imageSchemaItems = entries
  .map((entry) => {
    const originalUrl = photoOriginalUrls[entry.data.imagePath];
    if (!originalUrl) return null;
    const contentUrl = new URL(originalUrl, Astro.site).href;
    const imageModule = photoModules[entry.data.imagePath]?.default;
    return {
      "@type": "ImageObject" as const,
      contentUrl,
      name: entry.data.title,
      ...(entry.data.description && { description: entry.data.description }),
      datePublished: entry.data.date.toISOString(),
      creator: { "@type": "Person" as const, "@id": aboutUrl, name: SITE_TITLE },
      creditText: SITE_TITLE,
      copyrightNotice: `© ${entry.data.date.getFullYear()} ${SITE_TITLE}`,
      keywords: "furry, fursuit, furry convention",
      license: "https://creativecommons.org/licenses/by/4.0/",
      acquireLicensePage: "https://github.com/cytsai1008/kenichi-profile-photos/blob/main/LICENSE",
      ...(entry.data.location && {
        locationCreated: { "@type": "Place" as const, name: entry.data.location },
      }),
      ...(imageModule && {
        width: String(imageModule.width),
        height: String(imageModule.height),
      }),
    };
  })
  .filter((item) => item !== null);

// Group by album; undefined album → shown first under no heading
const albumMap = new Map<string | undefined, (typeof entries)[number][]>();
for (const entry of entries) {
  const album = entry.data.album;
  if (!albumMap.has(album)) albumMap.set(album, []);
  albumMap.get(album)!.push(entry);
}

// Sort: ungrouped first, then albums newest-first (by their latest photo)
const groups: { album: string | undefined; items: PhotoItem[] }[] = [];
const ungrouped = albumMap.get(undefined);
if (ungrouped?.length) {
  groups.push({ album: undefined, items: await Promise.all(ungrouped.map(toPhotoItem)) });
}
for (const [album, albumEntries] of albumMap) {
  if (album === undefined) continue;
  groups.push({ album, items: await Promise.all(albumEntries.map(toPhotoItem)) });
}

// ponytail: warn on duplicate deep-link slugs; human renames the file to fix.
const photoSlugCounts = new Map<string, number>();
for (const g of groups) {
  for (const i of g.items) {
    if (i.slug) photoSlugCounts.set(i.slug, (photoSlugCounts.get(i.slug) ?? 0) + 1);
  }
}
for (const [slug, n] of photoSlugCounts) {
  if (n > 1)
    console.warn(`[photos] duplicate #hash slug "${slug}" (${n} photos) — deep-link is ambiguous`);
}
---

<Layout title={tr.photos.title} description={tr.photos.description ?? ""} locale={locale}>
  {
    imageSchemaItems.length > 0 && (
      <Schema
        item={{
          "@context": "https://schema.org",
          "@graph": imageSchemaItems,
        }}
      />
    )
  }
  <div class="mx-auto max-w-5xl px-4 py-12">
    <header data-animate class="mb-10">
      <h1 class="text-4xl font-bold text-fg">{tr.photos.title}</h1>
      <p class="mt-2 text-lg text-fg-muted">{tr.photos.description}</p>
    </header>

    {
      groups.length === 0 ? (
        <p class="text-fg-muted">No photos yet.</p>
      ) : (
        groups.map(({ album, items }) => (
          <section data-animate class="mb-16">
            {album && (
              <h2 class="mb-6 border-b border-border pb-2 text-2xl font-bold text-fg">
                {formatAlbumName(album)}
              </h2>
            )}
            <PhotoViewer
              client:load
              photos={items}
              downloadLabel={tr.photos.download}
              closeLabel={tr.photos.close}
              zoomLabel={tr.photos.zoom}
              prevLabel={tr.photos.previous}
              nextLabel={tr.photos.next}
              showThumbnailsLabel={tr.photos.showThumbnails}
              hideThumbnailsLabel={tr.photos.hideThumbnails}
              showDownloadButton={true}
              showExifPanel={true}
              thumbClass="object-cover"
              placeholderSrc={true}
            />
          </section>
        ))
      )
    }
  </div>
</Layout>
