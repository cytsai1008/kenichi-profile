---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../BlogCard.astro";
import { t, localePath, type Locale } from "../../i18n/utils";
import { compareBlogPostsByDate, getBlogPostsForLocale } from "../../lib/blog";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

const recentPosts = getBlogPostsForLocale(await getCollection("blog"), locale)
  .sort(compareBlogPostsByDate)
  .slice(0, 3);

const latestGallery = (await getCollection("gallery"))
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.date.valueOf() - a.data.date.valueOf()
  )
  .slice(0, 6);

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/photos/**/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP,avif,AVIF,tiff,TIFF,tif,TIF,heic,HEIC,heif,HEIF}",
  { eager: true }
);

const galleryImageModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,WEBP,avif,AVIF,gif,GIF}",
  { eager: true }
);

function galleryAssetKey(relativePath: string): string {
  const m = relativePath.match(/assets\/(.+)$/);
  return m ? `/src/assets/${m[1]}` : "";
}

const latestPhotos = await Promise.all(
  (await getCollection("photos"))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 6)
    .map(async (entry) => {
      const imageModule = photoModules[entry.data.imagePath]?.default;
      const thumb = imageModule
        ? await getImage({
            src: imageModule,
            width: 640,
            height: 640,
            fit: "cover",
            quality: 85,
          })
        : null;

      return {
        title: entry.data.title,
        href: localePath("/photos", locale),
        src: thumb?.src ?? entry.data.imagePath,
      };
    })
);
---

<Layout title={tr.nav.home} description={tr.home.tagline} locale={locale}>
  <link
    slot="chiron-font"
    href="https://fonts.googleapis.com/css2?family=Chiron+GoRound+TC:wght@400;700&display=swap"
    rel="stylesheet"
  />
  <!-- Hero -->
  <section class="relative overflow-hidden px-4 pt-14 pb-10 sm:pt-18 sm:pb-20">
    <div class="relative mx-auto grid max-w-5xl gap-6 lg:items-stretch">
      <div
        data-animate
        class="rounded-4xl border border-border/30 bg-surface/88 p-7 shadow-[0_24px_80px_rgba(61,53,48,0.08)] backdrop-blur sm:p-10"
      >
        <div class="space-y-4">
          <div class="inline-block pt-8">
            <div class="relative inline-block">
              <p
                class="absolute bottom-full left-0 mb-1.5 w-full px-0.5 py-1.5 text-[clamp(0.8rem,1.8vw,0.95rem)] font-normal tracking-[0.2em] whitespace-nowrap text-accent uppercase"
              >
                {tr.home.greeting}
              </p>
              <h1 class="text-4xl leading-none font-bold text-fg sm:text-5xl">
                <span class="block font-chiron tracking-[0.05em] text-accent">健一</span>
                <span
                  class="mt-0.5 block font-chiron text-2xl leading-[1.1em] font-normal tracking-[0.4em] text-fg-muted uppercase sm:text-3xl"
                >
                  Kenichi
                </span>
              </h1>
            </div>
          </div>

          <p class="max-w-2xl text-lg leading-8 text-fg-muted sm:text-xl">
            {tr.home.tagline}
          </p>
        </div>

        <ul class="mt-10 flex list-none flex-wrap items-center gap-3 p-0">
          <li>
            <a
              href={localePath("/about", locale)}
              class="rounded-xl bg-accent-bg px-6 py-3 text-sm font-semibold text-white no-underline transition-colors hover:bg-accent-dim"
            >
              {tr.nav.about}
            </a>
          </li>
          <li>
            <a
              href={localePath("/gallery", locale)}
              class="rounded-full bg-surface-alt/55 px-6 py-3 text-sm font-semibold text-fg no-underline transition-colors hover:border-accent/40 hover:bg-surface-alt"
            >
              {tr.nav.gallery}
            </a>
          </li>
          <li>
            <a
              href={localePath("/photos", locale)}
              class="rounded-full bg-surface-alt/55 px-6 py-3 text-sm font-semibold text-fg no-underline transition-colors hover:border-accent/40 hover:bg-surface-alt"
            >
              {tr.nav.photos}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Recent Blog Posts -->
  {
    recentPosts.length > 0 && (
      <section class="px-4 py-12">
        <div class="mx-auto max-w-5xl px-7 sm:px-10">
          <div data-animate class="mb-8 flex items-center justify-between">
            <h2 class="text-2xl font-bold text-fg">{tr.home.recentPosts}</h2>
            <a href={localePath("/blog", locale)} class="text-sm font-medium text-accent">
              {tr.home.viewAll} →
            </a>
          </div>
          <div data-animate-stagger class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {recentPosts.map((post) => (
              <BlogCard post={post} locale={locale} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    latestGallery.length > 0 && (
      <section class="px-4 py-12">
        <div class="mx-auto max-w-5xl px-7 sm:px-10">
          <div data-animate class="mb-8 flex items-center justify-between">
            <h2 class="text-2xl font-bold text-fg">{tr.home.latestGallery}</h2>
            <a href={localePath("/gallery", locale)} class="text-sm font-medium text-accent">
              {tr.home.viewAll} →
            </a>
          </div>
          <div data-animate-stagger class="grid grid-cols-2 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {latestGallery.map((entry, i) => (
              <a
                data-animate
                href={localePath("/gallery", locale)}
                class:list={[
                  "group overflow-hidden rounded-2xl border border-border bg-surface-alt no-underline",
                  i >= 4 && "hidden lg:block",
                ]}
              >
                <div class="aspect-square overflow-hidden">
                  {(() => {
                    const img = galleryImageModules[galleryAssetKey(entry.data.image)]?.default;
                    return img ? (
                      <Image
                        src={img}
                        alt={entry.data.title}
                        width={480}
                        height={480}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                      />
                    ) : null;
                  })()}
                </div>
                <div class="p-3">
                  {entry.data.artist && (
                    <p class="mt-0.5 text-xs text-fg-muted">
                      {tr.gallery.creator}: {entry.data.artist}
                    </p>
                  )}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    latestPhotos.length > 0 && (
      <section class="px-4 py-12">
        <div class="mx-auto max-w-5xl px-7 sm:px-10">
          <div data-animate class="mb-8 flex items-center justify-between">
            <h2 class="text-2xl font-bold text-fg">{tr.home.latestPhotos}</h2>
            <a href={localePath("/photos", locale)} class="text-sm font-medium text-accent">
              {tr.home.viewAll} →
            </a>
          </div>
          <div data-animate-stagger class="grid grid-cols-2 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {latestPhotos.map((photo, i) => (
              <a
                data-animate
                href={photo.href}
                class:list={[
                  "group overflow-hidden rounded-2xl border border-border bg-surface-alt no-underline",
                  i >= 4 && "hidden lg:block",
                ]}
              >
                <div class="aspect-square overflow-hidden">
                  <img
                    src={photo.src}
                    alt={photo.title}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>
