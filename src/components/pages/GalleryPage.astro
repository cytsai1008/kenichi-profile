---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { t, type Locale } from "../../i18n/utils";
import PhotoViewer from "../PhotoViewer.vue";
import type { PhotoItem } from "../PhotoViewer.vue";
import { getManifestIndex } from "../../lib/galleryAssetManifest.js";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

function localizedValue(
  value: string | undefined,
  i18n: { "zh-tw"?: string; "zh-cn"?: string } | undefined
) {
  if (locale === "zh-tw") return i18n?.["zh-tw"] ?? value;
  if (locale === "zh-cn") return i18n?.["zh-cn"] ?? value;
  return value;
}

// Remote manifest index: keyed by logical asset path (e.g. "gallery-explicit/Baka_inuta.jpg").
// Falls back to an empty Map when the sync script has not been run yet.
const manifestIndex = getManifestIndex();

// Local asset glob — still used for entries whose image path points at src/assets
// (repo-local assets, e.g. the ref-sheet which is checked in directly).
// Frontmatter paths are relative to src/content/gallery/ (e.g. "../../assets/foo.jpg").
// We extract everything after "assets/" and look up under /src/assets/.
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,WEBP,avif,AVIF,gif,GIF}",
  { eager: true }
);
const imageUrls = import.meta.glob<string>(
  "/src/assets/**/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,WEBP,avif,AVIF,gif,GIF}",
  {
    query: "?url",
    import: "default",
    eager: true,
  }
);

function assetKey(relativePath: string): string {
  const m = relativePath.match(/assets\/(.+)$/);
  return m ? `/src/assets/${m[1]}` : "";
}

// Filename (minus extension) used for `#hash` deep-linking, e.g.
// "gallery-explicit/Baka_inuta.jpg" -> "Baka_inuta".
function slugFromImage(image: string): string {
  return (
    image
      .split("/")
      .pop()
      ?.replace(/\.[^.]+$/, "") ?? image
  );
}

/**
 * Detect whether a frontmatter image value is a logical remote asset path
 * (e.g. "gallery-explicit/Baka_inuta.jpg") rather than a repo-local relative
 * path (e.g. "../../assets/commissions/Baka_inuta.jpg").
 */
function isRemotePath(image: string): boolean {
  return !image.startsWith(".") && !image.startsWith("/") && !image.includes("assets/");
}

const all = (await getCollection("gallery")).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = ["all", "ref-sheet", "commission", "gift-art", "other"] as const;
const categoryLabels: Record<(typeof categories)[number], string> = {
  all: tr.gallery.all,
  "ref-sheet": tr.gallery.refSheet,
  commission: tr.gallery.commission,
  "gift-art": tr.gallery.giftArt,
  other: tr.gallery.other,
};

function isPhotoItem(item: PhotoItem | null): item is PhotoItem {
  return item !== null;
}

async function buildPhotoItem(entry: (typeof all)[number]): Promise<PhotoItem | null> {
  const imageValue = entry.data.image;

  // --- Remote manifest path (explicit content) ---
  if (isRemotePath(imageValue)) {
    const manifestEntry = manifestIndex.get(imageValue);
    if (!manifestEntry) {
      console.warn(
        `[gallery] remote asset not in build manifest: ${imageValue} — run gallery:sync`
      );
      return null;
    }
    return {
      src: manifestEntry.viewerUrl,
      thumb: manifestEntry.thumbUrl,
      slug: slugFromImage(imageValue),
      width: manifestEntry.width,
      height: manifestEntry.height,
      alt: localizedValue(entry.data.title, entry.data.titleI18n) ?? entry.data.title,
      title: localizedValue(entry.data.title, entry.data.titleI18n),
      subtitle: localizedValue(entry.data.artist, entry.data.artistI18n)
        ? `${tr.gallery.creator}: ${localizedValue(entry.data.artist, entry.data.artistI18n)}`
        : undefined,
      subtitleUrl: entry.data.artistUrl,
      creator: localizedValue(entry.data.artist, entry.data.artistI18n),
      creatorUrl: entry.data.artistUrl,
      category: entry.data.category,
      featured: entry.data.featured,
    } satisfies PhotoItem;
  }

  // --- Repo-local asset path (regular content) ---
  const key = assetKey(imageValue);
  const imageModule = imageModules[key]?.default;
  const originalUrl = imageUrls[key];
  if (!imageModule || !originalUrl) {
    console.warn(`[gallery] image not found: ${imageValue} (key: ${key})`);
    return null;
  }

  const [thumb, viewerImage] = await Promise.all([
    getImage({ src: imageModule, width: 640, quality: 85 }),
    getImage({ src: imageModule, width: imageModule.width, quality: 92 }),
  ]);

  return {
    src: viewerImage.src,
    thumb: thumb.src,
    slug: slugFromImage(imageValue),
    width: viewerImage.attributes.width ?? imageModule.width,
    height: viewerImage.attributes.height ?? imageModule.height,
    alt: localizedValue(entry.data.title, entry.data.titleI18n) ?? entry.data.title,
    title: localizedValue(entry.data.title, entry.data.titleI18n),
    subtitle: localizedValue(entry.data.artist, entry.data.artistI18n)
      ? `${tr.gallery.creator}: ${localizedValue(entry.data.artist, entry.data.artistI18n)}`
      : undefined,
    subtitleUrl: entry.data.artistUrl,
    creator: localizedValue(entry.data.artist, entry.data.artistI18n),
    creatorUrl: entry.data.artistUrl,
    category: entry.data.category,
    featured: entry.data.featured,
  } satisfies PhotoItem;
}

// Build one sorted array; explicit items are marked isExplicit: true.
const allItemsMaybe = await Promise.all(
  all.map(async (entry) => {
    const item = await buildPhotoItem(entry);
    if (!item) return null;
    return isRemotePath(entry.data.image) ? { ...item, isExplicit: true as const } : item;
  })
);

const allItems = allItemsMaybe.filter(isPhotoItem);
const regularItems = allItems.filter((i) => !i.isExplicit);
const explicitItems = allItems.filter((i) => i.isExplicit);

const droppedCount = all.length - allItems.length;
if (droppedCount > 0) {
  console.warn(
    `[gallery] ${droppedCount} entries were dropped — ` +
      `run \`npm run gallery:sync\` if remote assets are missing from the build manifest`
  );
}
---

<Layout title={tr.gallery.title} description={tr.gallery.description ?? ""} locale={locale}>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <header data-animate class="mb-10">
      <h1 class="text-4xl font-bold text-fg">{tr.gallery.title}</h1>
      <p class="mt-2 text-lg text-fg-muted">{tr.gallery.description}</p>
    </header>

    <!-- Category filter buttons -->
    <div
      data-animate
      class="relative mb-10 flex flex-wrap items-center gap-2 border-b border-border pb-6"
      id="gallery-filters"
      role="group"
      aria-label="Filter by category"
    >
      <div aria-hidden="true" class="gallery-filter-pill"></div>
      {
        categories.map((cat) => {
          const label = categoryLabels[cat];
          const regularCount =
            cat === "all"
              ? regularItems.length
              : regularItems.filter((item) => item.category === cat).length;
          const explicitCount =
            cat === "all"
              ? explicitItems.length
              : explicitItems.filter((item) => item.category === cat).length;
          return (
            <button
              data-category={cat}
              data-regular-count={regularCount}
              data-explicit-count={explicitCount}
              class="gallery-filter relative z-10 rounded-full border border-border px-4 py-1.5 text-sm font-medium text-fg-muted transition-colors"
              aria-pressed={cat === "all" ? "true" : "false"}
            >
              {label}
              <span class="ml-1 text-xs opacity-60">({regularCount})</span>
            </button>
          );
        })
      }
      {
        explicitItems.length > 0 && (
          <button
            id="explicit-toggle"
            class="explicit-toggle ml-auto rounded-full border border-explicit/50 px-4 py-1.5 text-sm font-medium text-explicit/80 transition-colors duration-150 hover:border-explicit/70 hover:text-explicit"
            aria-pressed="false"
          >
            {tr.gallery.explicitToggle}
          </button>
        )
      }
    </div>

    <div id="gallery-panel" class="explicit-hidden">
      {
        allItems.length === 0 ? (
          <p class="text-fg-muted">No artwork yet.</p>
        ) : (
          <PhotoViewer
            client:load
            photos={allItems}
            closeLabel={tr.photos.close}
            zoomLabel={tr.photos.zoom}
            prevLabel={tr.photos.previous}
            nextLabel={tr.photos.next}
            creatorLabel={tr.gallery.creator}
            showDownloadButton={false}
            showExifPanel={false}
            itemClass="gallery-item border border-border"
            alwaysShowText={true}
            disableHoverZoom={true}
          />
        )
      }
    </div>

    <!-- +18 warning modal -->
    {
      explicitItems.length > 0 && (
        <div
          id="explicit-modal"
          class="fixed inset-0 z-[200] hidden"
          role="dialog"
          aria-modal="true"
          aria-labelledby="explicit-modal-title"
        >
          <div id="explicit-modal-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm" />
          <div class="relative flex h-full items-center justify-center p-4">
            <div class="explicit-modal-box overflow-hidden rounded-2xl border border-border shadow-2xl">
              <div class="px-6 pt-6 pb-4">
                <p class="mb-1 text-xs font-semibold tracking-widest text-explicit uppercase">
                  {tr.gallery.explicitWarningTag}
                </p>
                <h2 id="explicit-modal-title" class="text-xl font-bold text-fg">
                  {tr.gallery.explicitWarningTitle}
                </h2>
              </div>
              <div class="px-6 pb-5">
                <p class="max-w-xs text-sm leading-relaxed text-fg-muted">
                  {tr.gallery.explicitWarningBody}
                </p>
              </div>
              <div class="flex gap-2 border-t border-border bg-surface-alt/60 px-6 py-4">
                <button
                  id="explicit-cancel"
                  class="flex-1 rounded-lg px-4 py-2 text-sm font-medium whitespace-nowrap text-fg transition-colors"
                >
                  {tr.gallery.explicitCancel}
                </button>
                <button
                  id="explicit-confirm"
                  class="flex-1 rounded-lg bg-explicit-bg px-4 py-2 text-sm font-semibold whitespace-nowrap text-white transition-colors focus-visible:outline-2 focus-visible:outline-explicit"
                >
                  {tr.gallery.explicitShow}
                </button>
              </div>
            </div>
          </div>
        </div>
      )
    }
  </div>
</Layout>

<script>
  import { animate } from "animejs";

  // Read explicit preference first — needed by matchesCategory
  const EXPLICIT_KEY = "gallery-explicit-shown";
  let explicitEnabled = localStorage.getItem(EXPLICIT_KEY) === "true";

  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>(".gallery-filter"));
  const filterBar = document.getElementById("gallery-filters");
  const filterPill = document.querySelector<HTMLElement>(".gallery-filter-pill");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  let activeCategory = "all";
  let switchToken = 0;
  let activeButton: HTMLButtonElement | null = null;

  function getItems() {
    return Array.from(document.querySelectorAll<HTMLElement>(".gallery-item"));
  }

  function matchesCategory(item: HTMLElement, category: string) {
    if (item.dataset.explicit && !explicitEnabled) return false;
    return category === "all" || item.dataset.category === category;
  }

  function updateFilterCounts() {
    filters.forEach((button) => {
      const regular = parseInt(button.dataset.regularCount ?? "0");
      const explicit = parseInt(button.dataset.explicitCount ?? "0");
      const total = explicitEnabled ? regular + explicit : regular;
      const span = button.querySelector("span");
      if (span) span.textContent = `(${total})`;
    });
  }

  function setActiveFilter(activeButton: HTMLButtonElement) {
    filters.forEach((button) => {
      const isActive = button === activeButton;
      button.setAttribute("aria-pressed", isActive ? "true" : "false");
      button.classList.toggle("text-white", isActive);
      button.classList.toggle("border-transparent", isActive);
      button.classList.toggle("text-fg-muted", !isActive);
      button.classList.toggle("border-border", !isActive);
    });
  }

  function getButtonMetrics(button: HTMLButtonElement) {
    if (!filterBar || !button) return null;

    const barRect = filterBar.getBoundingClientRect();
    const buttonRect = button.getBoundingClientRect();

    return {
      left: buttonRect.left - barRect.left,
      top: buttonRect.top - barRect.top,
      width: buttonRect.width,
      height: buttonRect.height,
    };
  }

  function placeFilterPill(button: HTMLButtonElement) {
    const metrics = getButtonMetrics(button);
    if (!filterPill || !metrics) return null;

    filterPill.style.left = `${metrics.left}px`;
    filterPill.style.top = `${metrics.top}px`;
    filterPill.style.width = `${metrics.width}px`;
    filterPill.style.height = `${metrics.height}px`;
    filterPill.dataset.ready = "true";
    return metrics;
  }

  function moveFilterPill(button: HTMLButtonElement, instant = false) {
    if (!filterPill || !button) return;

    const next = getButtonMetrics(button);
    if (!next) return;

    if (!activeButton || instant || prefersReducedMotion.matches) {
      placeFilterPill(button);
      activeButton = button;
      return;
    }

    const prev = getButtonMetrics(activeButton) ?? next;
    placeFilterPill(button);

    const deltaX = prev.left - next.left;
    const deltaY = prev.top - next.top;
    const scaleX = prev.width / next.width;
    const scaleY = prev.height / next.height;

    activeButton = button;

    // Pill is morphing across the screen → ease-in-out, and it stays under the
    // 300ms UI budget so it never gates the grid transition behind it.
    animate(filterPill, {
      translateX: [deltaX, 0],
      translateY: [deltaY, 0],
      scaleX: [scaleX, 1],
      scaleY: [scaleY, 1],
      duration: 220,
      ease: "inOut(3)",
    });
  }

  function refreshMasonry() {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        window.dispatchEvent(new Event("resize"));
      });
    });
  }

  function setVisibility(category: string) {
    const items = getItems();
    items.forEach((item) => {
      const isMatch = matchesCategory(item, category);
      item.style.display = isMatch ? "" : "none";

      if (isMatch) {
        item.style.opacity = "";
        item.style.transform = "";
        item.setAttribute("data-pswp", "");
      } else {
        item.removeAttribute("data-pswp");
      }
    });
    refreshMasonry();
  }

  async function switchFilter(category: string, button: HTMLButtonElement) {
    if (category === activeCategory) return;

    activeCategory = category;
    const token = ++switchToken;

    setActiveFilter(button);
    moveFilterPill(button); // runs alongside the grid — never gates it

    if (prefersReducedMotion.matches) {
      setVisibility(category);
      return;
    }

    const items = getItems();
    if (!items.length) return;

    const visibleItems = items.filter((item) => item.style.display !== "none");
    const incoming = items.filter((item) => matchesCategory(item, category));

    if (visibleItems.length) {
      // Target-only values (no `from`) so a click mid-transition retargets from
      // wherever the items currently are instead of snapping back to opacity 1.
      await animate(visibleItems, {
        opacity: 0,
        scale: 0.96,
        translateY: 12,
        duration: 150,
        // Capped stagger — uncapped, 26 items add a ~400ms tail to the exit
        // alone, and the whole grid transition is stuck behind it.
        delay: (_el: HTMLElement, i: number) => Math.min(i, 5) * 12,
        ease: "out(3)",
      }).then();
    }

    if (token !== switchToken) return; // a newer click took over

    visibleItems.forEach((item) => {
      item.style.display = "none";
      item.removeAttribute("data-pswp");
    });

    incoming.forEach((item) => {
      item.style.display = "";
      item.setAttribute("data-pswp", "");
    });

    refreshMasonry();

    if (incoming.length) {
      await animate(incoming, {
        opacity: [0, 1],
        scale: [0.96, 1],
        translateY: [12, 0],
        duration: 240,
        delay: (_el: HTMLElement, i: number) => Math.min(i, 8) * 25,
        ease: "out(3)",
      }).then();
    }

    refreshMasonry();
  }

  filters.forEach((button) => {
    button.addEventListener("click", () => {
      void switchFilter(button.dataset.category || "all", button);
    });
  });

  function initFilters() {
    const first = filters[0];
    if (first) {
      setActiveFilter(first);
      moveFilterPill(first, true);
    }
  }

  window.addEventListener("resize", () => {
    if (activeButton) {
      moveFilterPill(activeButton, true);
    }
  });

  if (document.querySelector(".gallery-item")) {
    initFilters();
  } else {
    requestAnimationFrame(() => {
      initFilters();
    });
  }

  // === Explicit +18 toggle ===
  const explicitToggle = document.getElementById("explicit-toggle");
  const galleryPanel = document.getElementById("gallery-panel");
  const explicitModal = document.getElementById("explicit-modal");

  function enableExplicit() {
    explicitEnabled = true;
    galleryPanel?.classList.remove("explicit-hidden");
    explicitToggle?.setAttribute("aria-pressed", "true");
    localStorage.setItem(EXPLICIT_KEY, "true");
    updateFilterCounts();
    setVisibility(activeCategory);
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        window.dispatchEvent(new Event("resize"));
      });
    });
  }

  function disableExplicit() {
    explicitEnabled = false;
    galleryPanel?.classList.add("explicit-hidden");
    explicitToggle?.setAttribute("aria-pressed", "false");
    localStorage.removeItem(EXPLICIT_KEY);
    updateFilterCounts();
    setVisibility(activeCategory);
  }

  function showModal() {
    explicitModal?.classList.remove("hidden");
    document.getElementById("explicit-confirm")?.focus();
  }

  function hideModal() {
    explicitModal?.classList.add("hidden");
    explicitToggle?.focus();
  }

  explicitToggle?.addEventListener("click", () => {
    if (explicitEnabled) disableExplicit();
    else showModal();
  });

  document.getElementById("explicit-confirm")?.addEventListener("click", () => {
    hideModal();
    enableExplicit();
  });

  document.getElementById("explicit-cancel")?.addEventListener("click", hideModal);
  document.getElementById("explicit-modal")?.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest(".explicit-modal-box")) hideModal();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !explicitModal?.classList.contains("hidden")) {
      hideModal();
    }
  });

  window.addEventListener("cc:explicitDisabled", () => {
    if (explicitEnabled) disableExplicit();
  });

  // On load: strip data-pswp from explicit items so the lightbox ignores them
  // until the user enables explicit mode. Run in rAF to let Vue hydrate first.
  requestAnimationFrame(() => {
    if (explicitEnabled) {
      galleryPanel?.classList.remove("explicit-hidden");
      explicitToggle?.setAttribute("aria-pressed", "true");
      updateFilterCounts();
      requestAnimationFrame(() => window.dispatchEvent(new Event("resize")));
    } else {
      document.querySelectorAll<HTMLElement>("[data-explicit]").forEach((item) => {
        item.removeAttribute("data-pswp");
      });
    }
  });
</script>

<style>
  .gallery-filter-pill {
    position: absolute;
    z-index: 0;
    border-radius: 999px;
    background: var(--accent-bg);
    opacity: 0;
    transform-origin: center center;
    will-change: transform;
  }

  .gallery-filter-pill[data-ready="true"] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-filter-pill {
      transition: none;
    }
  }

  .explicit-modal-box {
    background: color-mix(in srgb, var(--surface), transparent 10%);
    backdrop-filter: blur(16px);
    width: fit-content;
    min-width: 16rem;
    max-width: min(90vw, 30rem);
    transition:
      opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* Entrance when the modal goes from display:none to rendered. Modal is
     centered in the viewport, so transform-origin: center is correct here. */
  @starting-style {
    .explicit-modal-box {
      opacity: 0;
      transform: scale(0.96);
    }

    #explicit-modal-backdrop {
      opacity: 0;
    }
  }

  #explicit-modal-backdrop {
    transition: opacity 200ms ease;
  }

  #explicit-cancel:hover {
    background: color-mix(in srgb, var(--border) 60%, var(--surface-alt));
  }

  #explicit-confirm:hover {
    background: color-mix(in srgb, var(--explicit-bg), #000 20%);
  }

  /* Hide explicit items until the toggle is on */
  :global(.explicit-hidden [data-explicit]) {
    display: none;
  }

  .explicit-toggle[aria-pressed="true"] {
    background: var(--explicit-bg);
    border-color: transparent;
    color: #fff;
  }

  :global(.gallery-item[data-explicit]) {
    background-color: color-mix(in srgb, var(--surface-alt) 82%, var(--explicit-bg) 18%);
    border-color: color-mix(in srgb, var(--explicit) 35%, transparent);
  }
</style>
