---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { t, type Locale } from "../../i18n/utils";
import PhotoViewer from "../PhotoViewer.vue";
import type { PhotoItem } from "../PhotoViewer.vue";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);

function localizedValue(
  value: string | undefined,
  i18n: { "zh-tw"?: string; "zh-cn"?: string } | undefined
) {
  if (locale === "zh-tw") return i18n?.["zh-tw"] ?? value;
  if (locale === "zh-cn") return i18n?.["zh-cn"] ?? value;
  return value;
}

// Resolve images via glob to avoid Astro content layer image() caching bug.
// Frontmatter paths are relative to src/content/gallery/ (e.g. "../../assets/foo.jpg").
// We extract everything after "assets/" and look up under /src/assets/.
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,WEBP,avif,AVIF,gif,GIF}",
  { eager: true }
);
const imageUrls = import.meta.glob<string>(
  "/src/assets/**/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,WEBP,avif,AVIF,gif,GIF}",
  {
    query: "?url",
    import: "default",
    eager: true,
  }
);

function assetKey(relativePath: string): string {
  const m = relativePath.match(/assets\/(.+)$/);
  return m ? `/src/assets/${m[1]}` : "";
}

const all = (await getCollection("gallery")).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = ["all", "ref-sheet", "commission", "gift-art", "other"] as const;
const categoryLabels: Record<(typeof categories)[number], string> = {
  all: tr.gallery.all,
  "ref-sheet": tr.gallery.refSheet,
  commission: tr.gallery.commission,
  "gift-art": tr.gallery.giftArt,
  other: tr.gallery.other,
};

function isPhotoItem(item: PhotoItem | null): item is PhotoItem {
  return item !== null;
}

const galleryItems: PhotoItem[] = await Promise.all(
  all.map(async (entry): Promise<PhotoItem | null> => {
    const key = assetKey(entry.data.image);
    const imageModule = imageModules[key]?.default;
    const originalUrl = imageUrls[key];
    if (!imageModule || !originalUrl) {
      console.warn(`[gallery] image not found: ${entry.data.image} (key: ${key})`);
      return null;
    }

    const [thumb, viewerImage] = await Promise.all([
      getImage({ src: imageModule, width: 640, quality: 85 }),
      getImage({ src: imageModule, width: imageModule.width, quality: 92 }),
    ]);

    return {
      src: viewerImage.src,
      thumb: thumb.src,
      width: viewerImage.attributes.width ?? imageModule.width,
      height: viewerImage.attributes.height ?? imageModule.height,
      alt: localizedValue(entry.data.title, entry.data.titleI18n) ?? entry.data.title,
      title: localizedValue(entry.data.title, entry.data.titleI18n),
      subtitle: localizedValue(entry.data.artist, entry.data.artistI18n)
        ? `${tr.gallery.creator}: ${localizedValue(entry.data.artist, entry.data.artistI18n)}`
        : undefined,
      subtitleUrl: entry.data.artistUrl,
      creator: localizedValue(entry.data.artist, entry.data.artistI18n),
      creatorUrl: entry.data.artistUrl,
      category: entry.data.category,
      featured: entry.data.featured,
    } satisfies PhotoItem;
  })
).then((items) => items.filter(isPhotoItem));
---

<Layout title={tr.gallery.title} description={tr.gallery.description ?? ""} locale={locale}>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <header data-animate class="mb-10">
      <h1 class="text-4xl font-bold text-fg">{tr.gallery.title}</h1>
      <p class="mt-2 text-lg text-fg-muted">{tr.gallery.description}</p>
    </header>

    <!-- Category filter tabs -->
    <div
      data-animate
      class="relative mb-10 flex flex-wrap gap-2 border-b border-border pb-6"
      role="tablist"
      aria-label="Filter by category"
    >
      <div aria-hidden="true" class="gallery-filter-pill"></div>
      {
        categories.map((cat) => {
          const label = categoryLabels[cat];
          const count =
            cat === "all"
              ? galleryItems.length
              : galleryItems.filter((item) => item.category === cat).length;
          return (
            <button
              role="tab"
              data-category={cat}
              class="gallery-filter relative z-10 rounded-full border border-border px-4 py-1.5 text-sm font-medium text-fg-muted transition-colors"
              aria-selected={cat === "all" ? "true" : "false"}
            >
              {label}
              <span class="ml-1 text-xs opacity-60">({count})</span>
            </button>
          );
        })
      }
    </div>

    {
      galleryItems.length === 0 ? (
        <p class="text-fg-muted">No artwork yet.</p>
      ) : (
        <PhotoViewer
          client:load
          photos={galleryItems}
          closeLabel={tr.photos.close}
          zoomLabel={tr.photos.zoom}
          prevLabel={tr.photos.previous}
          nextLabel={tr.photos.next}
          creatorLabel={tr.gallery.creator}
          showDownloadButton={false}
          showExifPanel={false}
          itemClass="gallery-item border border-border"
          alwaysShowText={true}
          disableHoverZoom={true}
        />
      )
    }
  </div>
</Layout>

<script>
  import { animate, stagger } from "animejs";

  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>(".gallery-filter"));
  const filterBar = document.querySelector<HTMLElement>("[role='tablist']");
  const filterPill = document.querySelector<HTMLElement>(".gallery-filter-pill");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  let activeCategory = "all";
  let isTransitioning = false;
  let activeButton: HTMLButtonElement | null = null;

  function getItems() {
    return Array.from(document.querySelectorAll<HTMLElement>(".gallery-item"));
  }

  function matchesCategory(item: HTMLElement, category: string) {
    return category === "all" || item.dataset.category === category;
  }

  function setActiveFilter(activeButton: HTMLButtonElement) {
    filters.forEach((button) => {
      const isActive = button === activeButton;
      button.setAttribute("aria-selected", isActive ? "true" : "false");
      button.classList.toggle("text-white", isActive);
      button.classList.toggle("border-transparent", isActive);
      button.classList.toggle("text-fg-muted", !isActive);
      button.classList.toggle("border-border", !isActive);
    });
  }

  function getButtonMetrics(button: HTMLButtonElement) {
    if (!filterBar || !button) return null;

    const barRect = filterBar.getBoundingClientRect();
    const buttonRect = button.getBoundingClientRect();

    return {
      left: buttonRect.left - barRect.left,
      top: buttonRect.top - barRect.top,
      width: buttonRect.width,
      height: buttonRect.height,
    };
  }

  function placeFilterPill(button: HTMLButtonElement) {
    const metrics = getButtonMetrics(button);
    if (!filterPill || !metrics) return null;

    filterPill.style.left = `${metrics.left}px`;
    filterPill.style.top = `${metrics.top}px`;
    filterPill.style.width = `${metrics.width}px`;
    filterPill.style.height = `${metrics.height}px`;
    filterPill.dataset.ready = "true";
    return metrics;
  }

  async function moveFilterPill(button: HTMLButtonElement, instant = false) {
    if (!filterPill || !button) return;

    const next = getButtonMetrics(button);
    if (!next) return;

    if (!activeButton || instant || prefersReducedMotion.matches) {
      placeFilterPill(button);
      activeButton = button;
      return;
    }

    const prev = getButtonMetrics(activeButton) ?? next;
    placeFilterPill(button);

    const deltaX = prev.left - next.left;
    const deltaY = prev.top - next.top;
    const scaleX = prev.width / next.width;
    const scaleY = prev.height / next.height;

    const travel = Math.max(Math.abs(deltaX), Math.abs(deltaY));
    const drift = Math.max(-5, Math.min(5, deltaX * 0.04));

    const pillAnimation = animate(filterPill, {
      translateX: [deltaX, 0],
      translateY: [deltaY, 0],
      scaleX: [Math.max(scaleX, 0.82) * 1.12, 1],
      scaleY: [Math.max(scaleY, 0.88) * 0.92, 1],
      rotate: [drift, 0],
      duration: travel > 64 ? 560 : 440,
      ease: "out(5)",
    });

    activeButton = button;
    await pillAnimation.then();
  }

  function refreshMasonry() {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        window.dispatchEvent(new Event("resize"));
      });
    });
  }

  function setVisibility(category: string) {
    const items = getItems();
    items.forEach((item) => {
      item.style.display = matchesCategory(item, category) ? "" : "none";
    });
    refreshMasonry();
  }

  async function switchFilter(category: string, button: HTMLButtonElement) {
    if (isTransitioning || category === activeCategory) return;

    isTransitioning = true;
    filters.forEach((filter) => {
      filter.disabled = true;
    });

    try {
      setActiveFilter(button);
      await moveFilterPill(button);

      if (prefersReducedMotion.matches) {
        setVisibility(category);
        activeCategory = category;
        return;
      }

      const items = getItems();
      if (!items.length) {
        activeCategory = category;
        return;
      }

      const visibleItems = items.filter((item) => item.style.display !== "none");
      const incoming = items.filter((item) => matchesCategory(item, category));

      if (visibleItems.length) {
        await animate(visibleItems, {
          opacity: [1, 0],
          scale: [1, 0.92],
          translateY: [0, 24],
          duration: 260,
          delay: stagger(24, { from: "center" }),
          ease: "in(3)",
        }).then();
      }

      visibleItems.forEach((item) => {
        item.style.display = "none";
      });

      incoming.forEach((item) => {
        item.style.display = "";
      });

      refreshMasonry();

      if (incoming.length) {
        await animate(incoming, {
          opacity: [0, 1],
          scale: [0.92, 1],
          translateY: [22, 0],
          duration: 420,
          delay: stagger(48),
          ease: "out(5)",
        }).then();
      }

      refreshMasonry();
      activeCategory = category;
    } finally {
      isTransitioning = false;
      filters.forEach((filter) => {
        filter.disabled = false;
      });
    }
  }

  filters.forEach((button) => {
    button.addEventListener("click", () => {
      void switchFilter(button.dataset.category || "all", button);
    });
  });

  function initFilters() {
    const first = filters[0];
    if (first) {
      setActiveFilter(first);
      void moveFilterPill(first, true);
    }
  }

  window.addEventListener("resize", () => {
    if (activeButton) {
      void moveFilterPill(activeButton, true);
    }
  });

  if (document.querySelector(".gallery-item")) {
    initFilters();
  } else {
    requestAnimationFrame(() => {
      initFilters();
    });
  }
</script>

<style>
  .gallery-filter-pill {
    position: absolute;
    z-index: 0;
    border-radius: 999px;
    background: var(--accent-bg);
    opacity: 0;
    transform-origin: center center;
    will-change: transform;
  }

  .gallery-filter-pill[data-ready="true"] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-filter-pill {
      transition: none;
    }
  }
</style>
