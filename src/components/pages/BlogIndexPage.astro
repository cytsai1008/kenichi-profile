---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../BlogCard.astro";
import { t, type Locale } from "../../i18n/utils";
import {
  compareBlogPostsByDate,
  compareFeaturedBlogPosts,
  getBlogPostsForLocale,
} from "../../lib/blog";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const blogFontClass =
  locale === "zh-tw" ? "font-noto-tc" : locale === "zh-cn" ? "font-noto-sc" : "";

const allPosts = getBlogPostsForLocale(await getCollection("blog"), locale);
const pinned = allPosts.filter((p) => p.data.featured).sort(compareFeaturedBlogPosts);
const posts = allPosts.filter((p) => !p.data.featured).sort(compareBlogPostsByDate);
---

<Layout title={tr.blog.title} description={tr.blog.description} locale={locale}>
  <div class:list={["mx-auto max-w-5xl px-4 py-12", blogFontClass]}>
    <header data-animate class="mb-10">
      <h1 class="text-4xl font-bold text-fg">{tr.blog.title}</h1>
      <p class="mt-2 text-lg text-fg-muted">{tr.blog.description}</p>
    </header>

    {
      pinned.length > 0 && (
        <>
          <div data-animate-stagger class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {pinned.map((post) => (
              <BlogCard post={post} locale={locale} featured={true} />
            ))}
          </div>
          {posts.length > 0 && (
            <div data-animate class="my-10 border-t border-border" aria-hidden="true" />
          )}
        </>
      )
    }

    {
      posts.length === 0 && pinned.length === 0 ? (
        <p class="text-fg-muted">No posts yet.</p>
      ) : posts.length > 0 ? (
        <div data-animate-stagger class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <BlogCard post={post} locale={locale} />
          ))}
        </div>
      ) : null
    }
  </div>
</Layout>
