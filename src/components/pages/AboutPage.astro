---
import { Image } from "astro:assets";
import { Aperture, Camera } from "@lucide/astro";
import Layout from "../../layouts/Layout.astro";
import SocialLinks from "../SocialLinks.astro";
import { t, nl, type Locale } from "../../i18n/utils";
import refSheet from "../../assets/ref-sheet.png";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const socialLinks = [
  { label: "Facebook", href: "https://r.photocat.blue/facebook", icon: "simple-icons:facebook" },
  { label: "Twitter", href: "https://r.photocat.blue/x", icon: "simple-icons:twitter" },
  { label: "GitHub", href: "https://r.photocat.blue/github", icon: "simple-icons:github" },
  {
    label: "VRChat",
    href: "https://r.photocat.blue/vrchat",
    icon: "simple-icons:vrchat",
    iconWidth: 32,
    iconHeight: 32,
  },
  { label: "Other Link", href: "https://link.photocat.blue/", icon: "lucide:link" },
];
---

<Layout title={tr.about.title} description={tr.home.tagline} locale={locale}>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <h1 data-animate class="mb-8 text-4xl font-bold text-fg">{tr.about.title}</h1>

    <div class="space-y-10">
      <section data-animate>
        <h2 class="mb-3 text-2xl font-bold">{tr.about.character}</h2>
        <div class="grid gap-8 sm:grid-cols-3 lg:grid-cols-2">
          <figure>
            <div class="overflow-hidden rounded-2xl">
              <Image
                src={refSheet}
                alt={`${tr.about.name} ${tr.gallery.refSheet}`}
                sizes="(min-width: 640px) 50vw, 100vw"
                fetchpriority="high"
              />
            </div>
            <figcaption class="mt-2 text-center text-xs text-fg-muted">
              {tr.gallery.refSheet}
            </figcaption>
          </figure>

          <div class="sm:col-span-2 lg:col-span-1">
            {
              /* pb-6 = figcaption's mt-2 + text-xs line — ends the list at the image, not the caption */
            }
            <dl
              class="space-y-4 lg:flex lg:h-full lg:flex-col lg:justify-between lg:space-y-0 lg:pb-6"
            >
              <div>
                <dt class="text-xs font-semibold tracking-[0.18em] text-fg-muted uppercase">
                  {tr.about.nameLabel}
                </dt>
                <dd class="mt-1 text-lg font-medium text-fg">{tr.about.name}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold tracking-[0.18em] text-fg-muted uppercase">
                  {tr.about.speciesLabel}
                </dt>
                <dd class="mt-1 text-lg font-medium text-fg">{tr.about.speciesValue}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold tracking-[0.18em] text-fg-muted uppercase">
                  {tr.about.pronounsLabel}
                </dt>
                <dd class="mt-1 text-lg font-medium text-fg">{tr.about.pronounsValue}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold tracking-[0.18em] text-fg-muted uppercase">
                  {tr.about.hobbiesLabel}
                </dt>
                <dd class="mt-1 text-lg font-medium text-fg">{tr.about.hobbiesValue}</dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <section data-animate>
        <h2 class="mb-4 text-2xl font-bold">{tr.about.person}</h2>
        <div class="prose max-w-none">
          {nl(tr.about.intro).map((para) => <p>{para}</p>)}
        </div>
      </section>

      <section data-animate>
        <h2 class="mb-4 text-2xl font-bold">{tr.about.gear}</h2>
        <div class="relative overflow-hidden rounded-2xl py-2 pr-6">
          {/* oversized flat aperture mark — graphic anchor, not decoration */}
          <Aperture
            class="pointer-events-none absolute -right-6 -bottom-8 h-36 w-36 text-accent/10"
            stroke-width={1}
            aria-hidden="true"
          />
          {/* gold Nikkor ring traced on the aperture's edge */}
          <span
            class="pointer-events-none absolute -right-6 -bottom-8 h-36 w-36 rounded-full border-2 border-[#a89461]/40"
            aria-hidden="true"></span>
          <dl class="relative z-10 grid gap-6 sm:grid-cols-2">
            <div class="relative overflow-hidden sm:min-h-40">
              {/* camera emblem cut by the body cell's right edge, desktop only */}
              <Camera
                class="pointer-events-none absolute -right-6 -bottom-12 hidden h-40 w-40 text-accent/10 sm:block"
                stroke-width={1}
                aria-hidden="true"
              />
              <dt
                class="text-[0.7rem] tracking-[0.28em] text-accent-dim uppercase dark:text-accent"
              >
                {tr.about.bodyLabel}
              </dt>
              <dd class="mt-1.5 text-xl font-semibold text-fg">{tr.about.bodyValue}</dd>
              <dd class="mt-1.5 text-xs text-fg-muted">{tr.about.bodySpec}</dd>
            </div>

            <div>
              <dt
                class="text-[0.7rem] tracking-[0.28em] text-accent-dim uppercase dark:text-accent"
              >
                {tr.about.lensLabel}
              </dt>
              <dd class="mt-1.5 text-xl font-semibold text-fg">{tr.about.lensValue}</dd>
              <dd class="mt-1.5 text-xs text-fg-muted">{tr.about.lensSpec}</dd>
            </div>
          </dl>
        </div>
      </section>

      <section>
        <h2 data-animate class="mb-4 text-2xl font-bold">{tr.about.linksTitle}</h2>
        <SocialLinks links={socialLinks} />
      </section>
    </div>
  </div>
</Layout>
